# Copy this file to .env and adjust values for your machine.
# Never commit your real .env file.

# --- Server ---------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Set true only once you understand the LAN exposure implications (see README > Sicurezza).
DEVELOPMENT_MODE=true
ALLOW_REMOTE_CONNECTIONS=false

# --- Security ---------------------------------------------------------------
# Optional bearer token Android must send as `Authorization: Bearer <token>`.
# Leave empty to disable auth during local development.
API_TOKEN=
MAX_REQUEST_BODY_BYTES=1000000
RATE_LIMIT_PER_MINUTE=120

# --- Request handling ---------------------------------------------------------------
REQUEST_TIMEOUT=120
MAX_CONCURRENT_REQUESTS=2
MAX_QUEUE_SIZE=16

# --- Conversation / context ---------------------------------------------------------------
MAX_CONVERSATION_MESSAGES=20
MAX_CONTEXT_CHARS=12000

# --- FAST model ---------------------------------------------------------------
# backend: fake | ollama | llamacpp
FAST_MODEL_BACKEND=fake
FAST_MODEL_NAME=fast-fake
FAST_MODEL_PATH=
FAST_CONTEXT_SIZE=4096
FAST_THREADS=4
FAST_GPU_LAYERS=0
FAST_BASE_URL=http://127.0.0.1:11434

# --- BRAIN model ---------------------------------------------------------------
# backend: fake | ollama | llamacpp
BRAIN_MODEL_BACKEND=fake
BRAIN_MODEL_NAME=brain-fake
BRAIN_MODEL_PATH=
BRAIN_CONTEXT_SIZE=8192
BRAIN_THREADS=4
BRAIN_GPU_LAYERS=0
BRAIN_BASE_URL=http://127.0.0.1:11434

# --- Routing heuristics ---------------------------------------------------------------
ROUTER_FAST_MAX_CHARS=220
ROUTER_BRAIN_KEYWORDS=perché,pianifica,analizza,confronta,spiega in dettaglio,ragiona,progetta,strategia,why,plan,analyze,compare,design,reasoning
ROUTER_FAST_KEYWORDS=ciao,ok,grazie,che ore sono,accendi,spegni,hi,hello,thanks

# --- Prompts ---------------------------------------------------------------
SYSTEM_PROMPT_PATH=config/prompts/jarvis_system.txt

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
